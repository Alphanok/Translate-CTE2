		}
		{
			dependencies: ["201E621A52FFCE65"]
			description: ["Убивая монстров и исследуя карту, вы заметите, как увеличиваются проценты убийств и добычи. Эти два показателя формируют вашу общую &eредкость исследования&r. Чем выше уровень исследования, тем лучше будет награда за победу над &eбоссом карты&r. По мере дальнейшего исследования редкость исследования будет повышаться, начиная с &aнеобычной&r как первого этапа."]
			icon: "minecraft:paper"
			id: "4983FE0DE8A1377F"
			rewards: [{
				id: "72DE3FED05338CB6"
				item: "mmorpg:currency/map_rarity_upgrade"
